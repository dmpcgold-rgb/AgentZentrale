# Nur serverseitig! Niemals ins Android-Projekt eintragen.
HOST=127.0.0.1
PORT=8787
# Zufälliges Geheimnis mit mindestens 24 Zeichen. Beispiel: openssl rand -hex 32
AGENTZENTRALE_ACCESS_TOKEN=
# Optional für den KI-Chat und Codevorschläge. Kann API-Kosten verursachen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30
# Für öffentliche Repositories ist Lesen ohne Token möglich.
# Für private Repositories und PRs: Fine-grained Token nur für freigegebene Repos.
GITHUB_TOKEN=
GITHUB_ALLOWED_OWNERS=dmpcgold-rgb
# Aus Sicherheitsgründen standardmäßig aus.
ENABLE_GITHUB_WRITE=false
# Optional: eigener verifizierter, autorisierter WESTbahn-Anbieteradapter (lokales Modul).
# Ohne diesen Adapter KEINE Live-Buchungen und keine Automatik.
WESTBAHN_ADAPTER_MODULE=
WESTBAHN_LEDGER=./data/westbahn.json
# Optionaler Cloud-Browser (nur Suche, keine Buchungen):
WESTBAHN_BROWSER_ENABLED=false
WESTBAHN_BROWSER_PROFILE=./data/westbahn-browser
# Python mit Playwright; optional vorhandenes Chromium angeben:
WESTBAHN_PYTHON=python3
# WESTBAHN_CHROMIUM_PATH=/usr/bin/chromium
